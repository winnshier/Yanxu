#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$ROOT_DIR"

if ! node -e 'const [major, minor] = process.versions.node.split(".").map(Number); process.exit(major > 22 || (major === 22 && minor >= 13) ? 0 : 1)' 2>/dev/null; then
  echo "Yanxu requires Node.js 22.13.0 or newer. Switch Node using nvm, fnm, mise, or your preferred version manager."
  exit 1
fi

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pnpm is required to install and build the source checkout. Install any version compatible with this lockfile, then run ./yanxu again."
  exit 1
fi

if [ ! -d node_modules ]; then
  pnpm install --frozen-lockfile
fi

check_sqlite_runtime() {
  pnpm --filter @yanxu/core exec node -e 'const Database = require("better-sqlite3"); const database = new Database(":memory:"); database.close()'
}

if ! check_sqlite_runtime >/dev/null 2>&1; then
  echo "The installed better-sqlite3 binary does not match Node.js $(node --version). Rebuilding it for the current Node.js runtime..."
  pnpm --filter @yanxu/core rebuild better-sqlite3
  if ! check_sqlite_runtime >/dev/null 2>&1; then
    echo "Failed to load better-sqlite3 after rebuilding. Ensure the macOS Command Line Tools are installed, then run ./yanxu again."
    exit 1
  fi
fi

case "${1:-start}" in
  dev)
    exec pnpm dev
    ;;
  start)
    pnpm build
    export YANXU_OPEN_BROWSER="${YANXU_OPEN_BROWSER:-1}"
    exec pnpm start
    ;;
  *)
    echo "Usage: ./yanxu [start|dev]"
    exit 1
    ;;
esac
